# LLM Wiki Template — .gitignore

# ── Session exports — local only, never commit raw transcripts ────────────────
sessions/exports/*
sessions/confidential/*
sessions/wiki-digests/*
!sessions/exports/.gitkeep
!sessions/confidential/.gitkeep
!sessions/wiki-digests/.gitkeep

# ── SQLite index — regenerable from exports ──────────────────────────────────
sessions.db
sessions.db-shm
sessions.db-wal

# ── Transient / local-only Claude Code state ─────────────────────────────────
.claude/no-export
.claude/hooks.log
.claude/settings.json
.claude/settings.local.json

# ── Obsidian workspace state — machine-specific ──────────────────────────────
.obsidian/

# ── Raw sources — local only (size + third-party copyright) ──────────────────
raw/*
!raw/.gitkeep

# ── OS and editor noise ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Scratchpad — working drafts, local only
scratchpad/
